# ==============================================================================
# TRIPINN HOLIDAYS CRM - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and populate with your real project values.
# NEVER commit .env.local or real secrets to source control.
# ==============================================================================

# Next.js Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY is server-side only and never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# WHATSAPP BUSINESS PLATFORM CLOUD API (Official Meta Cloud API)
# ------------------------------------------------------------------------------
WHATSAPP_ACCESS_TOKEN=your-meta-whatsapp-system-user-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-whatsapp-waba-account-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-random-secure-webhook-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-signature-validation
WHATSAPP_API_VERSION=v21.0

# ------------------------------------------------------------------------------
# META CONVERSIONS API (MESSAGING WORKFLOW FOR CTWA ADS)
# ------------------------------------------------------------------------------
# Meta Pixel or Dataset ID linked to your Business Portfolio
META_DATASET_ID=your-meta-dataset-or-pixel-id
# Dedicated system user access token for CAPI events
META_CONVERSIONS_API_TOKEN=your-meta-conversions-api-system-user-token
# Test event code from Meta Events Manager (optional, for testing conversions)
META_TEST_EVENT_CODE=

# ------------------------------------------------------------------------------
# EXPERIMENTAL WHATSAPP QR CONNECTION (ISOLATED BAILEYS DAEMON)
# ------------------------------------------------------------------------------
# Internal URL of the running Baileys service (default: http://127.0.0.1:3001)
WHATSAPP_QR_SERVICE_URL=http://127.0.0.1:3001
# Pre-shared internal bearer secret between Next.js and the Baileys daemon
WHATSAPP_QR_SERVICE_SECRET=your-random-internal-shared-secret-here
