# ==============================================================================
# EXPERIMENTAL WHATSAPP QR SERVICE CONFIGURATION
# ==============================================================================

PORT=3001
HOST=127.0.0.1

# Shared secret for authenticating requests from Next.js CRM
SERVICE_SECRET=your-random-internal-shared-secret-here

# Supabase configuration (for experimental table synchronization)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Session storage path (defaults to ./sessions)
SESSIONS_DIR=./sessions

